+__forceinline__ __device__ uint2 fp8x4_to_bf16x4(uchar4 codes,
+                                                  float scale) {
+    const __nv_bfloat162 packed01 = __float22bfloat162_rn(
+        make_float2(static_cast<float>(cutlass::float_e4m3_t::bitcast(codes.x)) * scale,
+                    static_cast<float>(cutlass::float_e4m3_t::bitcast(codes.y)) * scale));
+    const __nv_bfloat162 packed23 = __float22bfloat162_rn(
+        make_float2(static_cast<float>(cutlass::float_e4m3_t::bitcast(codes.z)) * scale,
+                    static_cast<float>(cutlass::float_e4m3_t::bitcast(codes.w)) * scale));
+    return make_uint2(*reinterpret_cast<const uint32_t *>(&packed01),
+                      *reinterpret_cast<const uint32_t *>(&packed23));
+}
+
+__forceinline__ __device__ uint2 cubic8x4_to_bf16x4(
+        char4 codes, float scale, int curve) {
+    const int coeff_a = curve == 0 ? 4 : (curve == 3 ? 3 : 2);
+    const int coeff_b = curve == 2 ? 1 : (curve == 3 ? -1 : 0);
+    const int coeff_c = curve == 0 ? 0 : (curve == 2 ? 1 : 2);
+    constexpr float kInverseDenominator =
+        1.0f / (4.0f * 127.0f * 127.0f * 127.0f);
+    const float combined_scale = scale * kInverseDenominator;
+    auto decode = [&](int code) {
+        const int magnitude = min(code < 0 ? -code : code, 127);
+        const int polynomial =
+            ((coeff_c * magnitude + coeff_b * 127) * magnitude +
+             coeff_a * 127 * 127) * magnitude;
+        const int signed_polynomial = code < 0 ? -polynomial : polynomial;
+        return static_cast<float>(signed_polynomial) * combined_scale;
+    };
+    const __nv_bfloat162 packed01 = __float22bfloat162_rn(
+        make_float2(decode(static_cast<int>(codes.x)),
+                    decode(static_cast<int>(codes.y))));
+    const __nv_bfloat162 packed23 = __float22bfloat162_rn(
+        make_float2(decode(static_cast<int>(codes.z)),
+                    decode(static_cast<int>(codes.w))));
+    return make_uint2(*reinterpret_cast<const uint32_t *>(&packed01),
+                      *reinterpret_cast<const uint32_t *>(&packed23));
+}
